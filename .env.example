# Copy this file to .env and replace both placeholder secrets.
DB_PASSWORD=replace-with-a-local-database-password

# Generate in PowerShell: & { $bytes = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes); [Convert]::ToBase64String($bytes) }
JWT_SECRET_BASE64=replace-with-a-base64-encoded-32-byte-secret

# Host ports. Change these only if the defaults are already occupied.
APP_PORT=8080
DB_PORT=5434
